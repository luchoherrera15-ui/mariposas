# Credenciales de tu proyecto de Supabase.
# Las encontrás en: Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-el-anon-key

# OBLIGATORIA para /admin (el panel administrativo). Es la service_role key de
# Supabase: Project Settings -> API. NUNCA la subas a git ni la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Poner en "true" para forzar los datos de ejemplo aunque Supabase este configurado.
NEXT_PUBLIC_DEMO_DATA=

# Correos del sitio (Resend). El dominio tiene que estar verificado en Resend.
RESEND_API_KEY=
CORREO_REMITENTE="Tropical Butterfly Exports <info@tropicalbutterflies.lat>"

# Buzón de /admin/correo: remitente de lo que se responde desde el panel y
# clave compartida con el Email Worker de Cloudflare (cloudflare/worker-buzon.js).
CORREO_BUZON="Tropical Butterfly Exports <info@tropicalbutterflies.lat>"
CORREO_WEBHOOK_SECRETO=
